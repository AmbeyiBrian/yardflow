# Copy to `.env` on the box and fill in. Never commit the filled copy (N-4).
#
#   cp .env.example .env && chmod 600 .env
#
# Production settings refuse to boot when a required value is missing, so an
# incomplete file fails loudly at start rather than quietly at runtime.

# --- Where it lives -------------------------------------------------------

# The base domain. Tenants are subdomains *of this*: silvertech.<this>.
TENANT_BASE_DOMAIN=yardflow.buniva.co.ke

# Leading dot = this domain and every subdomain, which is what tenants need.
DJANGO_ALLOWED_HOSTS=.yardflow.buniva.co.ke,web,localhost

# Where Let's Encrypt sends expiry warnings. A real mailbox somebody reads.
ACME_EMAIL=ops@buniva.co.ke

# The SPA and the API are one origin, so there is no cross-origin request to
# allow. Left empty deliberately; filling it in would widen the surface for
# nothing.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://*.yardflow.buniva.co.ke

# --- Secrets --------------------------------------------------------------

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

POSTGRES_DB=yardflow
POSTGRES_USER=yardflow
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Host `postgres` is the compose service, not the internet.
DATABASE_URL=postgres://yardflow:CHANGE_ME@postgres:5432/yardflow
REDIS_URL=redis://redis:6379/0

# --- Attachments (N-7) ----------------------------------------------------
# Photographs and documents go to S3, never to the box: the instance has one
# small disk and a snapshot of it is not a backup of somebody's evidence.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Where the nightly database dump goes. May be the same bucket.
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=30

# --- Email ----------------------------------------------------------------
# SES SMTP. Until the account is out of the sandbox, only verified addresses
# receive anything — password resets included.
EMAIL_HOST=email-smtp.eu-west-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@yardflow.buniva.co.ke

# --- SMS (T8.11) ----------------------------------------------------------
# Leave blank and the channel stays off. All three are needed together:
# UjumbeSMS authenticates with the key *and* the account email, and refuses a
# sender ID not approved for the account.
UJUMBE_SMS_API_KEY=
UJUMBE_SMS_ACCOUNT_EMAIL=
UJUMBE_SMS_SENDER_ID=

# --- WhatsApp (T8.12) -----------------------------------------------------
# Written and off until Meta approves a sender and templates (D30).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Logging --------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
