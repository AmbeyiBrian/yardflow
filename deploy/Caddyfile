# Reverse proxy and TLS (design §12.2).
#
# Three jobs: terminate TLS for every tenant subdomain, serve the built SPA, and
# pass the API through to Django on the same origin.
#
# **Same origin is the point.** The SPA calls `/api/v1/...` relative, so serving
# both from one hostname means there is no CORS to configure and no preflight on
# every request. It also means the tenant's subdomain reaches Django unchanged
# in the Host header, which is how the tenant is resolved at all (§2.2).
#
# **Certificates are issued on demand**, not from a wildcard. A wildcard would
# need a DNS-01 challenge, which would need Route 53 credentials sitting on this
# box. On-demand issues an ordinary per-hostname certificate over HTTP-01 — but
# the DNS record is a wildcard, so *any* name reaches us, and without a gate
# Caddy would try to obtain a certificate for each one until the certificate
# authority rate-limited the whole domain. `ask` is that gate: Django is asked
# whether the name belongs to a tenant before a certificate is attempted.

{
	email {$ACME_EMAIL}

	on_demand_tls {
		# `ask` is the whole defence. Caddy used to offer `interval`/`burst`
		# rate limiting here as a second line; it was removed, and leaving it
		# in stops Caddy booting at all. So this endpoint has to be right: it
		# is the only thing between a wildcard DNS record and a few thousand
		# certificate requests for names nobody registered.
		ask http://web:8000/internal/tls-allowed
	}
}

# Every tenant subdomain. `https://` with no host list means "on demand, for
# whatever passes the ask".
*.{$TENANT_BASE_DOMAIN} {
	tls {
		on_demand
	}

	encode zstd gzip

	# The API, the attachment downloads, and the tenant's own logo. The Host
	# header is forwarded unchanged — Caddy does this by default, and it is what
	# tells Django which tenant is being asked for.
	@backend path /api/* /admin-api/* /attachments/* /media/* /health /internal/*
	handle @backend {
		reverse_proxy web:8000
	}

	# Django's own admin and the static files it collected.
	@django path /django-admin/* /static/*
	handle @django {
		reverse_proxy web:8000
	}

	# Built assets: real files or a real 404, never the SPA shell.
	#
	# This block exists because of a failure that looked like "the app gets
	# stuck". A tab left open across a deploy still holds the *old* chunk
	# filenames. When it asked for one, the catch-all below answered with
	# index.html — 200, text/html — and, because the path matched /assets/*, told
	# the browser to cache that HTML under the chunk's URL for a year. The
	# import failed, the recovery code never saw a 404, and the screen froze
	# with the URL already changed. A missing chunk must be a 404 so the stale-
	# bundle reload (§7.1) has something to recognise.
	@assets path /assets/* /workbox-*.js /registerSW.js
	handle @assets {
		root * /srv/www
		# Hashed filenames change whenever their contents do, so a hit can be
		# cached hard. The `file` matcher makes this a hit and only a hit: the
		# plain `header` directive applies to every response in the block, and
		# the first version of this stamped a year-long `immutable` onto the
		# 404 as well.
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the SPA. `try_files` sends unknown paths to index.html
	# so a deep link like /projects/42 loads the app rather than a 404 — the app
	# then reads the path itself.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server

		# index.html and the service worker must never be cached, or a deploy
		# would not reach anybody already running the old one.
		@volatile path /index.html /sw.js /manifest.webmanifest
		header @volatile Cache-Control "no-cache"
		# A deep link served as the shell is still the shell.
		header Cache-Control "no-cache"
	}

	log {
		output stdout
		format json
	}
}

# The bare domain. Nobody signs in here — there is no tenant in the hostname, so
# Django could not resolve one (§2.2) — so say where to go rather than serving
# a login form that cannot work.
{$TENANT_BASE_DOMAIN} {
	tls {
		on_demand
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		respond "YardFlow. Sign in at your organization's own address, for example https://silvertech.{$TENANT_BASE_DOMAIN}" 200
	}
}
