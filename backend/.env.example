# Copy to backend/.env and adjust. `.env` is git-ignored.
#
# Requirement N-4: no secret ever enters the repository. Locally these are
# throwaway development values; in production every one of them comes from AWS
# Secrets Manager and `config.settings.prod` refuses to boot without the
# required ones.

# --- Django ---------------------------------------------------------------
# Optional locally (dev.py has an insecure default). REQUIRED in production.
# DJANGO_SECRET_KEY=

# Africa/Nairobi is the platform default (N-9). Each tenant can override its
# own display timezone in OrganizationSettings.
DJANGO_TIME_ZONE=Africa/Nairobi

# Set to true to echo every SQL statement while debugging.
DJANGO_LOG_SQL=false

# --- Database -------------------------------------------------------------
# Postgres only — row-level security, JSONB and window functions are all load
# bearing (design §2.3, §3.4).
#
# Matches docker-compose.yml. If you run a native Postgres instead, point this
# at that instance; only one of the two can hold port 5432.
# The application connects as a non-superuser, non-BYPASSRLS role so that
# row-level security is actually enforced against it (T1.7, §2.3).
DATABASE_URL=postgres://yardflow_app:yardflow@localhost:5432/yardflow

# Migrations need to create tables and RLS policies, so they run as the owner
# role instead. Put the real password in `.env` — never here.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGEME@localhost:5432/yardflow

# --- Redis (Celery broker and cache) --------------------------------------
REDIS_URL=redis://localhost:6379/0

# Run Celery work in-process, so local development needs no worker.
CELERY_TASK_ALWAYS_EAGER=true

# --- Tenancy --------------------------------------------------------------
# Organizations are addressed by subdomain (§2.2): silvertech.localhost:5173
# locally, silvertech.yardflow.co.ke in production.
TENANT_BASE_DOMAIN=localhost
PLATFORM_ADMIN_SUBDOMAIN=admin

# --- SMS: UjumbeSMS (T8.11) -----------------------------------------------
# Development ignores these: SMS_BACKEND below stays the logging adapter, which
# prints the message instead of sending it, so nothing can reach a real
# technician from a developer's machine (§12.0).
#
# To send real SMS — staging or production — set all four:
#
#   1. SMS_BACKEND, to switch adapters. This is the whole of "switching
#      provider is a settings change".
#   2. UJUMBE_SMS_API_KEY — from the UjumbeSMS dashboard.
#   3. UJUMBE_SMS_ACCOUNT_EMAIL — the email the account logs in with. UjumbeSMS
#      authenticates on the key *and* the email, so the key alone will 401.
#   4. UJUMBE_SMS_SENDER_ID — the approved sender ID, e.g. SILVERTECH. An
#      unapproved one is refused per message, not at configuration time.
#
# Then check it without messaging anybody:  python manage.py sms_selftest
#
# SMS_BACKEND=notifications.channels.ujumbe_sms.UjumbeSmsBackend
# UJUMBE_SMS_API_KEY=
# UJUMBE_SMS_ACCOUNT_EMAIL=
# UJUMBE_SMS_SENDER_ID=
# Only if the account was issued against the other host UjumbeSMS publishes.
# UJUMBE_SMS_BASE_URL=https://ujumbesms.co.ke

# --- WhatsApp: Meta Cloud API (T8.12) — written, tested, and off -----------
# Q1, §9.2: the Business API needs an approved sender and pre-registered message
# templates, which takes weeks and carries per-message cost. The adapter is
# finished and unit-tested against a mock; the channel ships **disabled** so the
# approval loop never waits on Meta's queue.
#
# When the sender and templates are approved, enabling it is:
#   1. these two values, and
#   2. turning `whatsapp` on in the tenant's notification settings screen.
# No code change and no deployment.
#
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Production only (Phase 9) --------------------------------------------
# Listed so the deployment contract is visible. `prod` will not start without
# DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, DATABASE_URL, REDIS_URL and
# AWS_STORAGE_BUCKET_NAME.
#
# DJANGO_ALLOWED_HOSTS=.yardflow.co.ke
# HEALTH_CHECK_HOST=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-1
# AWS_S3_URL_EXPIRY_SECONDS=300
# CORS_ALLOWED_ORIGINS=https://app.yardflow.co.ke
# CSRF_TRUSTED_ORIGINS=https://app.yardflow.co.ke
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@yardflow.co.ke
# DJANGO_LOG_LEVEL=INFO

# --- Fingerprint approval (WebAuthn) ---------------------------------------
#
# The relying-party id must equal the domain in the browser, or be a registrable
# parent of it. In production leave it unset: TENANT_BASE_DOMAIN (yardflow.co.ke)
# already covers every tenant subdomain.
#
# Locally it must be set, because browsers treat `localhost` as a top-level name,
# so it is not a registrable parent of `demo.localhost` and enrolment is refused.
# Use the exact host you open.
# WEBAUTHN_RP_ID=demo.localhost
